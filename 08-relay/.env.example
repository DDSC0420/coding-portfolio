# Copy to .env. Synthetic local credentials only; never commit a real .env.

# --- Used by docker compose ---
ENGINE_DB_PASSWORD=relay
CRM_DB_PASSWORD=relay
# RELAY_LEASE_SECONDS=15

# --- Used when running services, scripts or tests on the host ---
RELAY_DATABASE_URL=postgresql+psycopg://relay:relay@127.0.0.1:55432/relay_engine
CRM_DATABASE_URL=postgresql+psycopg://relay:relay@127.0.0.1:55433/relay_crm
RELAY_CRM_BASE_URL=http://127.0.0.1:8100
# The test suite creates throwaway databases on this server:
RELAY_TEST_ADMIN_URL=postgresql+psycopg://relay:relay@127.0.0.1:55432/postgres
